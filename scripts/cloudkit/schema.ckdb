DEFINE SCHEMA

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        "roles"         LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );

    RECORD TYPE Space (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        "name"          ENCRYPTED STRING,
        "icon"          ENCRYPTED STRING,
        "accent"        ENCRYPTED STRING,
        "theme"         ENCRYPTED BYTES,
        "profile"       ENCRYPTED STRING,
        "device"        ENCRYPTED STRING,
        "level"         STRING,
        "order"         STRING,
        "nameAt"        INT64,
        "iconAt"        INT64,
        "lookAt"        INT64,
        "levelAt"       INT64,
        "orderAt"       INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Item (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        "space"         STRING,
        "section"       STRING,
        "kind"          STRING,
        "parent"        STRING,
        "order"         STRING,
        "url"           ENCRYPTED STRING,
        "title"         ENCRYPTED STRING,
        "customTitle"   ENCRYPTED STRING,
        "device"        ENCRYPTED STRING,
        "positionAt"    INT64,
        "kindAt"        INT64,
        "urlAt"         INT64,
        "titleAt"       INT64,
        "customTitleAt" INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );
